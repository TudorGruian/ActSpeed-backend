# Copy to .env and load it however you prefer (direnv, `set -a; . ./.env`).
HTTP_ADDR=:8080
DASHBOARD_DIR=./dashboard/dist
ADMIN_TOKEN=
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgres://actspeed:actspeed@localhost:5432/actspeed?sslmode=disable

MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Claude. Leave the key empty to run on stored patterns only.
ANTHROPIC_API_KEY=
AI_MODEL_INTERPRET=claude-haiku-5-5
AI_MODEL_CORRECT=claude-sonnet-5-5
AI_MODEL_ASSIST=claude-haiku-5-5
AI_TIMEOUT=8s
AI_ASSIST_TIMEOUT=25s

# Speech: client | piper | elevenlabs
TTS_PROVIDER=client
PIPER_URL=http://localhost:5000
PIPER_VOICE=
PIPER_VOICE_RO=ro_RO-mihai-medium
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Attention call
ALERT_WEBHOOK_URL=
ALERT_MESSAGE=I need help, please come.
ALERT_MESSAGE_RO=Am nevoie de ajutor, vă rog să veniți.
